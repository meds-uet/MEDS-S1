# Basic formatting
--column_limit=100
--indentation_spaces=2
--line_break_penalty=2
--line_terminator=auto
--over_column_limit_penalty=100
--wrap_spaces=2

# Alignment
--assignment_statement_alignment=align
--case_items_alignment=align
--class_member_variable_alignment=align
--distribution_items_alignment=align
--enum_assignment_statement_alignment=align
--formal_parameters_alignment=align
--module_net_variable_alignment=align
--named_parameter_alignment=align
--named_port_alignment=align
--parameter_declaration_alignment=align
--port_declarations_alignment=align
--struct_union_members_alignment=align

# Indentation style
--formal_parameters_indentation=wrap
--named_parameter_indentation=wrap
--named_port_indentation=wrap
--port_declarations_indentation=wrap

# Style toggles
--class_parameter_space=false
--compact_indexing_and_selections=false
--expand_coverpoints=false
--port_declarations_right_align_packed_dimensions=true
--port_declarations_right_align_unpacked_dimensions=true
--try_wrap_long_lines=false
--wrap_end_else_clauses=false
--alignment_group_boundary=blank-lines

# Tool / runtime
--failsafe_success=true
#--inplace=true
--max_search_states=100000
--verify_convergence=true
--verbose=false

# Debug (defaults)
--show_equally_optimal_wrappings=false
--show_inter_token_info=false
--show_largest_token_partitions=0
--show_token_partition_tree=false

# Left at default on purpose:
# --lines=
# --stdin_name=<stdin>
