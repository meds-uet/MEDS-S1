`verilator_config
// Copyright 2026 Maktab-e-Digital Systems Lahore.
// SPDX-License-Identifier: Apache-2.0
//
// Lint waivers for MEDS-S1.
//
// ALL waivers live in this file and ALL of them carry a justification --
// CODING_STANDARD.md R-L2.  A waiver without a reason is a review blocker, not
// a style preference.
//
// Two gotchas when editing this file:
//   * `verilator_config must be the very first line.
//   * A comment must not begin with the tool's own name, or it is parsed as a
//     metacomment and becomes a syntax error.

// s1_pkg is a package of shared constants and types.  Any single module uses a
// subset of it; that is the point of a shared package, not a defect.
lint_off -rule UNUSEDPARAM -file "*s1_pkg.sv"

// meds_s1_axi4_pkg is the shared AXI4 package (widths, response codes, memory
// map, accelerator register offsets, axi_next_addr).  Any single module uses a
// subset of it -- same reasoning as s1_pkg above.
lint_off -rule UNUSEDPARAM -file "*meds_s1_axi4_pkg.sv"

// meds_s1_axi4_b_ch finds the last beat by counting AWLEN+1 beats, which AXI
// makes authoritative (the master must assert WLAST on exactly that beat).
// w_captured_last_i is carried so a protocol checker can compare the two later.
lint_off -rule UNUSEDSIGNAL -file "*meds_s1_axi4_b_ch.sv" -match "*w_captured_last_i*"

// meds_s1_axi4_crossbar's internal x_* buses are NSI-wide (NUM_SLAVES + 1),
// the extra slot being the internal DECERR sink. meds_s1_axi4_decerr_sink
// deliberately has no awaddr/awlen/awsize/awburst/araddr/arsize/arburst/
// wdata/wstrb ports -- it discards a rejected access without inspecting any
// of that -- so the DECERR-sink slice of those per-slave arrays is always
// driven and never read. Real slaves (index 0..NUM_SLAVES-1) use every bit.
lint_off -rule UNUSEDSIGNAL -file "*meds_s1_axi4_crossbar.sv"

// meds_s1_axi4_to_axil finds the last beat by counting AWLEN+1 beats, same
// reasoning as meds_s1_axi4_b_ch above; wlast_i is carried but not checked.
lint_off -rule UNUSEDSIGNAL -file "*meds_s1_axi4_to_axil.sv" -match "*wlast_i*"

// r_end is computed at full address width but only its word-select bits
// [4:2] are ever read (which 32-bit word of the 32-byte line a beat's last
// byte falls in); the rest of the arithmetic result is intentionally unused.
lint_off -rule UNUSEDSIGNAL -file "*meds_s1_axi4_to_axil.sv" -match "*r_end*"

// Testbenches legitimately declare signals that only some test paths drive, and
// deliberately mix widths when building corner-case stimulus.
lint_off -rule UNUSEDSIGNAL -file "*verif/unit/*"
lint_off -rule WIDTHTRUNC   -file "*verif/unit/*"
lint_off -rule WIDTHEXPAND  -file "*verif/unit/*"
lint_off -rule DECLFILENAME -file "*verif/*"

// `make lint` checks the whole RTL tree as a library, so there is deliberately
// no single top module.  Once the generator emits meds_s1_soc_top (R-04), the
// lint target gains --top-module and this waiver should be REMOVED.
lint_off -rule MULTITOP

